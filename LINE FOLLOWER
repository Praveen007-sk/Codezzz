// TWO WHEEL AND TWO SENSOR -LINE FOLLOWER ROBOT CODE
// -------- Motor Pins --------
int ENA = 5;
int IN1 = 6;
int IN2 = 7;
int IN3 = 8;
int IN4 = 9;
int ENB = 10;

// -------- Sensor Pins --------
int leftSensor = A0;
int rightSensor = A1;

// -------- PID Variables --------
float kp = 25;
float ki = 0.0;
float kd = 15;

float error = 0;
float previous_error = 0;
float integral = 0;
float derivative = 0;

int baseSpeed = 150;

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT);

  pinMode(leftSensor, INPUT);
  pinMode(rightSensor, INPUT);

  Serial.begin(9600);
}

void loop() {

  // Read sensors
  int leftValue = analogRead(leftSensor);
  int rightValue = analogRead(rightSensor);

  // Convert to binary (adjust threshold)
  int L = (leftValue > 500) ? 1 : 0;
  int R = (rightValue > 500) ? 1 : 0;

  // -------- ERROR --------
  error = R - L;

  // -------- PID --------
  integral = integral + error;
  derivative = error - previous_error;

  float PID_value = (kp * error) + (ki * integral) + (kd * derivative);

  previous_error = error;

  // -------- MOTOR SPEED --------
  int leftSpeed = baseSpeed - PID_value;
  int rightSpeed = baseSpeed + PID_value;

  leftSpeed = constrain(leftSpeed, 0, 255);
  rightSpeed = constrain(rightSpeed, 0, 255);

  // -------- MOVE --------
  moveForward(leftSpeed, rightSpeed);
}

// -------- MOTOR FUNCTION --------
void moveForward(int leftSpeed, int rightSpeed) {

  // Left motor forward
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  analogWrite(ENA, leftSpeed);

  // Right motor forward
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
  analogWrite(ENB, rightSpeed);
}
